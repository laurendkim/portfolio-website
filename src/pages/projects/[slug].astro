---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { projects, galleryFor } from '../../data/projects.js';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const images = galleryFor(project);
// Skip cover.jpg (index 0) and use only numbered images for collection
const collectionImages = images.slice(1);

// Portrait/landscape detection based on image aspect ratio hints
const isPortrait = (src: string) => {
  // Images with 03, 04 in path are portrait; 05+ may be landscape
  const num = src.match(/(\d+)\.jpg/)?.[1];
  if (!num) return false;
  const imgNum = parseInt(num);
  return imgNum === 3 || imgNum === 4;
};

// Layout: organize collection images based on orientation
const rows = [];
let i = 0;
while (i < collectionImages.length) {
  const current = collectionImages[i];
  const next = collectionImages[i + 1];
  const currentIsPortrait = isPortrait(current);
  const nextIsPortrait = next ? isPortrait(next) : false;

  // If current is portrait and next is also portrait, group them
  if (currentIsPortrait && nextIsPortrait && next) {
    rows.push({ type: 'two', imgs: [current, next] });
    i += 2;
  } else {
    // Single image (landscape or last in sequence)
    rows.push({ type: 'full', imgs: [current] });
    i += 1;
  }
}
---
<Base title={`${project.caption} — Lauren Kim`} description={project.subtitle ? project.subtitle.split('\n')[0] : project.caption}>
  <div class="project-page">
    <Header current={project.slug} />
    <article class="project">
    <!-- Project description (top) -->
    <div class="project-top">
      <div class="project-intro">
        <p class="project-desc">{project.desc}</p>
        {project.meta && <p class="project-meta">{project.meta}</p>}
      </div>
    </div>

    <!-- Hero images section -->
    {project.heroImages && (
      <div class="hero-section">
        <div class="hero-grid">
          {project.heroImages.map((src, idx) => (
            <img src={src} alt={`${project.caption} ${idx + 1}`} loading={idx === 0 ? "eager" : "lazy"} decoding="async" />
          ))}
        </div>
      </div>
    )}

    <!-- Goal statement (centered) -->
    {project.process && (
      <div class="goal-statement">
        <p>{project.process.goal}</p>
      </div>
    )}

    <!-- Process sections -->
    {project.process && (
      <div class="process-sections">
        <section class="process-item">
          <div class="color-imgs">
            {project.process.color.images ? (
              project.process.color.images.map((src) => (
                <img src={src} alt="Color Exploration" loading="lazy" decoding="async" />
              ))
            ) : (
              <img src={project.process.color.image} alt="Color Exploration" loading="lazy" decoding="async" />
            )}
          </div>
          <p>{project.process.color.text}</p>
        </section>

        <section class="process-item">
          <div class="process-imgs">
            {project.process.graphicExploration.images.map((src) => (
              <img src={src} alt="Graphic Exploration" loading="lazy" decoding="async" />
            ))}
          </div>
          <p>{project.process.graphicExploration.text}</p>
        </section>
      </div>
    )}

    <!-- Collection images -->
    <div class="seq">
      {rows.map((row) => (
        <div class={row.type}>
          {row.imgs.map((src) => (<img src={src} alt={project.caption} loading="lazy" decoding="async" />))}
        </div>
      ))}
    </div>
  </article>
  </div>
</Base>

<style>
  .project { padding: 0; }

  /* Project description at top */
  .project-top { padding: var(--pad) var(--pad) 0 var(--pad); display: flex; justify-content: flex-end; padding-top: 14rem; margin-bottom: 0.5rem; }
  .project-intro { max-width: 38rem; }
  .project-desc { margin: 1.1rem 0 1.1rem; font-size: 0.9rem; line-height: 1.15; color: rgba(0, 0, 0, 0.85); }
  .project-meta { margin: 0; font-size: 0.9rem; line-height: 1.15; color: rgba(0, 0, 0, 0.6); font-style: italic; }

  /* Hero images section - FLUSH to edges */
  .hero-section { padding: 0.75rem 0 2.2rem 0; }
  .hero-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.1rem; padding: 0; margin: 0; width: 100%; }
  .hero-grid img { width: 100%; display: block; }
  .hero-grid img:first-child { grid-column: 1 / -1; }
  .hero-grid img:nth-child(2) { grid-column: 1 / -1; }

  /* Goal statement - left-aligned text, centered on page (same spacing as hero-section) */
  .goal-statement { padding: 0.75rem var(--pad) 2.2rem var(--pad); display: flex; justify-content: center; }
  .goal-statement p { margin: 0; font-size: 0.9rem; line-height: 1.15; color: rgba(0, 0, 0, 0.85); max-width: 60rem; text-align: left; white-space: pre-line; }

  /* Process sections - TEXT indented, IMAGES flush */
  .process-sections { padding: 0; }
  .process-item { display: flex; flex-direction: column; margin: 2.2rem 0; width: 100%; }
  .process-item:first-child { margin-top: 0; }
  .process-item:last-child { margin-bottom: 0; }
  .process-item p { margin: 0; font-size: 0.9rem; line-height: 1.15; color: rgba(0, 0, 0, 0.85); padding: 0 var(--pad); white-space: pre-line; }
  .process-item > img { width: 100%; margin-left: 0; margin-right: 0; display: block; }
  .process-imgs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.1rem; width: 100%; margin-left: 0; margin-right: 0; grid-auto-rows: 1fr; padding: 0; box-sizing: border-box; }
  .process-imgs img { width: 100%; display: block; object-fit: cover; height: 100%; }

  /* Color images - landscape, full-width with consistent 1.1rem spacing */
  .color-imgs { display: flex; flex-direction: column; gap: 1.1rem; width: 100%; margin-left: 0; margin-right: 0; padding: 0; box-sizing: border-box; }
  .color-imgs img { width: 100%; display: block; margin: 0; }

  /* Collection images - FLUSH to edges */
  .seq { display: flex; flex-direction: column; gap: 1.1rem; padding: 0; margin: 2.2rem 0 0; width: 100%; }
  .seq img { width: 100%; display: block; }
  .seq .two { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  .seq .full { width: 100%; }

  @media (max-width: 800px) {
    .project-top { padding-top: 9rem; justify-content: flex-start; }
    .hero-grid { grid-template-columns: 1fr; gap: 2rem; padding: 2rem var(--pad); margin: 0; width: 100%; }
    .goal-statement { padding: 2.2rem var(--pad); }
    .process-sections { padding: 2rem var(--pad); }
    .process-imgs { grid-template-columns: 1fr; }
    .seq .two { grid-template-columns: 1fr; }
  }
</style>
