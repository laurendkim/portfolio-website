---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { projects } from '../../data/projects.js';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const images = project.images || [];
---

<Base title={`${project.caption} — Lauren Kim`} description={project.subtitle ? project.subtitle.split('\n')[0] : project.caption}>
  <div class="project-page">
    <Header current={project.slug} />
    <article class="project">
      <div class="project-top">
        <div class="project-intro">
          <p class="project-desc">{project.desc}</p>
          {project.meta && <p class="project-meta">{project.meta}</p>}
        </div>
      </div>
      <div class="image-grid">
        {images.map((filename) => (
          <img src={`${project.dir}/${filename}`} alt={project.caption} loading="lazy" decoding="async" />
        ))}
      </div>
    </article>
  </div>
</Base>

<style>
  .project { padding: 0; }
  .project-top { padding: var(--pad) var(--pad) 0 var(--pad); display: flex; justify-content: flex-end; padding-top: 14rem; margin-bottom: 0; }
  .project-intro { max-width: 38rem; }
  .project-desc { margin: 1.1rem 0 1.1rem; font-size: 0.9rem; line-height: 1.15; color: rgba(0, 0, 0, 0.85); }
  .project-meta { margin: 0 0 1.5rem 0; font-size: 0.9rem; line-height: 1.15; color: rgba(0, 0, 0, 0.6); font-style: italic; }
  .image-grid { display: grid; grid-template-columns: 1fr; gap: 1.1rem; padding: 0; margin: 0; width: 100%; }
  .image-grid img { width: 100%; display: block; }
  @media (max-width: 800px) {
    .project-top { justify-content: flex-start; padding-top: 9rem; }
  }
</style>
