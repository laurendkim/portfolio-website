---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { projects } from '../../data/projects.js';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const content = project.images || [];
---

<Base title={`${project.caption} — Lauren Kim`} description={project.subtitle ? project.subtitle.split('\n')[0] : project.caption}>
  <div class="project-page">
    <Header current={project.slug} />
    <article class="project">
      <div class="project-top">
        <div class="project-intro reveal">
          <p class="project-desc">{project.desc}</p>
          {project.meta && <p class="project-meta">{project.meta}</p>}
        </div>
      </div>
      <div class="image-grid">
        {content.map((item) => (
          item.type === 'text' ? (
            <div class="content-text reveal">
              {item.text.split('\n\n').map((para) => <p>{para}</p>)}
            </div>
          ) : (
            <img
              src={`${project.dir}/${item.name}`}
              alt={project.caption}
              loading="lazy"
              decoding="async"
              class={`reveal ${!item.portrait ? 'landscape' : 'portrait'}`}
            />
          )
        ))}
      </div>
    </article>
  </div>
</Base>

<style>
  .project { padding: 0; }
  .project-top { padding: 14rem 0 0 0; display: flex; justify-content: flex-end; margin-bottom: 0; }
  .project-intro { width: 100%; }
  .project-desc { margin: 1.1rem 0 1.1rem; font-size: 0.9rem; line-height: 1.15; color: rgba(0, 0, 0, 0.85); text-align: left; }
  .project-meta { margin: 0 0 1.5rem 0; font-size: 0.9rem; line-height: 1.15; color: rgba(0, 0, 0, 0.6); font-style: italic; text-align: left; }
  .image-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; padding: 0; margin: 0; width: 100%; }
  .image-grid img { width: 100%; display: block; }
  .image-grid img.portrait { aspect-ratio: 4 / 5; object-fit: cover; }
  .image-grid img.landscape { grid-column: 1 / -1; aspect-ratio: auto; }
  .content-text { grid-column: 1 / -1; width: 100%; margin: 0.4rem 0; }
  .content-text p { margin: 0 0 1.1rem; font-size: 0.9rem; line-height: 1.15; color: rgba(0, 0, 0, 0.85); text-align: left; }
  .content-text p:last-child { margin-bottom: 0; }
  @media (max-width: 800px) {
    .project-top { justify-content: flex-start; padding-top: 9rem; }
    .image-grid { grid-template-columns: 1fr; }
    .image-grid img.landscape { grid-column: 1; }
  }
</style>
