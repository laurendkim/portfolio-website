---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { projects } from '../data/projects.js';
import { v } from '../utils/assetVersion.js';

// Right column (high): 01, 03, 05 · Left column (staggered down): 02, 04, 06
const right = projects.filter((_, i) => i % 2 === 0);
const left = projects.filter((_, i) => i % 2 === 1);
---
<Base>
  <Header />
  <div class="home">
    <div class="grid grid-desktop">
      <div class="col col-left">
        {left.map((p) => (
          <div class="proj reveal" style={`--w:${p.width}vw`}>
            <a href={`/projects/${p.slug}`}><img class="proj-img" src={v(`${p.dir}/cover.jpg`)} alt={p.caption} loading="lazy" decoding="async" /></a>
            <div class="proj-meta">
              <p class="proj-caption"><a href={`/projects/${p.slug}`}>{p.caption}</a></p>
              <a class="proj-number" href={`/projects/${p.slug}`}>{p.num}</a>
            </div>
          </div>
        ))}
      </div>
      <div class="col col-right">
        {right.map((p) => (
          <div class="proj reveal" style={`--w:${p.width}vw`}>
            <a href={`/projects/${p.slug}`}><img class="proj-img" src={v(`${p.dir}/cover.jpg`)} alt={p.caption} loading="lazy" decoding="async" /></a>
            <div class="proj-meta">
              <p class="proj-caption"><a href={`/projects/${p.slug}`}>{p.caption}</a></p>
              <a class="proj-number" href={`/projects/${p.slug}`}>{p.num}</a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile only: same projects, staggered two-up collage (like desktop)
         but in correct numeric order. The two-column masonry above can't be
         reordered with CSS alone since it's split into separate left/right
         containers, so this is a parallel layout rather than a reflow of it. -->
    <div class="grid-mobile">
      {projects.map((p, i) => (
        <div class="proj reveal" style={`--w:${p.width}vw`} data-stagger={i % 2 === 1 ? 'down' : ''}>
          <a href={`/projects/${p.slug}`}><img class="proj-img" src={v(`${p.dir}/cover.jpg`)} alt={p.caption} loading="lazy" decoding="async" /></a>
          <div class="proj-meta">
            <p class="proj-caption"><a href={`/projects/${p.slug}`}>{p.caption}</a></p>
            <a class="proj-number" href={`/projects/${p.slug}`}>{p.num}</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Base>
