---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { projects } from '../data/projects.js';

// Right column (high): 01, 03, 05 · Left column (staggered down): 02, 04, 06
const right = projects.filter((_, i) => i % 2 === 0);
const left = projects.filter((_, i) => i % 2 === 1);
---
<Base>
  <Header />
  <div class="home">
    <div class="grid">
      <div class="col col-left">
        {left.map((p) => (
          <div class="proj reveal" style={`--w:${p.width}vw`}>
            <a href={`/projects/${p.slug}`}><img class="proj-img" src={`${p.dir}/cover.jpg`} alt={p.caption} loading="lazy" decoding="async" /></a>
            <div class="proj-meta">
              <p class="proj-caption"><a href={`/projects/${p.slug}`}>{p.caption}</a></p>
              <a class="proj-number" href={`/projects/${p.slug}`}>{p.num}</a>
            </div>
          </div>
        ))}
      </div>
      <div class="col col-right">
        {right.map((p) => (
          <div class="proj reveal" style={`--w:${p.width}vw`}>
            <a href={`/projects/${p.slug}`}><img class="proj-img" src={`${p.dir}/cover.jpg`} alt={p.caption} loading="lazy" decoding="async" /></a>
            <div class="proj-meta">
              <p class="proj-caption"><a href={`/projects/${p.slug}`}>{p.caption}</a></p>
              <a class="proj-number" href={`/projects/${p.slug}`}>{p.num}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Base>
