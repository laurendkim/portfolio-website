---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---
<Base title="Contact — Lauren Kim" description="For project inquiries and collaborations.">
  <Header />
  <section class="contact">
    <p class="overline">Contact</p>
    <p class="lead">
      For project inquiries and collaborations,<br />write to Lauren.
    </p>

    <!-- Netlify Forms: detected at build via data-netlify + hidden form-name. Submissions
         appear in the Netlify dashboard → Forms. -->
    <form name="inquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="form">
      <input type="hidden" name="form-name" value="inquiry" />
      <p class="hidden-field"><label>Don’t fill this out if you’re human: <input name="bot-field" /></label></p>

      <label class="field">
        <span>Name</span>
        <input type="text" name="name" required />
      </label>
      <label class="field">
        <span>Email</span>
        <input type="email" name="email" required />
      </label>
      <label class="field">
        <span>About the project</span>
        <textarea name="message" rows="6" required></textarea>
      </label>

      <button type="submit" class="submit">Send inquiry</button>
    </form>
  </section>
</Base>

<style>
  /* Centered on the page; type sized to match the header links (1.2rem). */
  .contact { max-width: 34rem; margin: 0 auto; padding: 9rem var(--pad) 4rem; text-align: center; }
  .overline { margin: 0 0 1.2rem; font-size: 1.2rem; font-weight: 500; letter-spacing: 0.03em; }
  .lead { margin: 0 0 2.2rem; font-size: 1.2rem; font-weight: 400; line-height: 1.45; }
  .form { display: flex; flex-direction: column; gap: 1.4rem; }
  .hidden-field { display: none; }
  .field { display: flex; flex-direction: column; gap: 0.35rem; }
  .field span { font-size: 1.05rem; color: rgba(0, 0, 0, 0.6); }
  .field input, .field textarea {
    border: none; border-bottom: 1px solid rgba(0, 0, 0, 0.25);
    background: transparent; font-family: inherit; font-size: 1.2rem; color: #000;
    padding: 0.4rem 0; text-align: center;
  }
  .field input:focus, .field textarea:focus { outline: none; border-bottom-color: #000; }
  .submit {
    align-self: center; margin-top: 0.6rem; cursor: pointer;
    background: #000; color: #f3f1ee; border: none;
    font-family: inherit; font-size: 1.15rem; padding: 0.7rem 1.7rem;
  }
  .submit:hover { opacity: 0.85; }
  .alt { display: flex; flex-direction: column; gap: 0.45rem; margin-top: 2.2rem; font-size: 1.2rem; }
  .alt a:hover { text-decoration: underline; }

  @media (max-width: 800px) {
    .contact { padding-top: 2rem; }
  }
</style>
